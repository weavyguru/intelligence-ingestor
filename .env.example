# ChromaDB Configuration
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_name
CHROMA_DATABASE=your_database_name

# Authentication
BEARER_TOKEN=your_bearer_token_here

# Performance Optimization Settings
# Number of ChromaDB connection pool connections (default: 1 for single worker)
CHROMA_POOL_SIZE=1

# Number of Uvicorn workers for multi-process deployment (default: 1)
# Set to 1 for development/debugging and ONNX stability
WORKERS=1

# Maximum concurrent requests (default: 5 for Railway stability)
MAX_CONCURRENT_REQUESTS=5

# Batch processing settings
# Maximum number of operations to batch together (default: 50)
CHROMA_BATCH_SIZE=50

# Batch timeout in seconds - process batch even if not full (default: 1.0)
CHROMA_BATCH_TIMEOUT=1.0

# Server Configuration
PORT=8000